{
  "name": "the-tons-claw",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "vite --host 0.0.0.0 --port 8080 --strictPort",
    "dev:backend": "cross-env PORT=3001 tsx watch src/backend/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/backend/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:seed": "npm run prisma:seed"
  },
  "dependencies": {
    "@prisma/client": "^5.16.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "prisma": "^5.16.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
